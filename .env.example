# Copy to .env and fill in. Never commit .env.

# WhatsApp Business Cloud API (Meta for Developers > your app > WhatsApp > API setup)
CLINICBOT_WHATSAPP_VERIFY_TOKEN=pick-a-long-random-string
CLINICBOT_WHATSAPP_APP_SECRET=
CLINICBOT_WHATSAPP_ACCESS_TOKEN=
CLINICBOT_WHATSAPP_PHONE_NUMBER_ID=

# Triage: "rules" (offline, default) or "llm" (any OpenAI-compatible endpoint, e.g. llm-gateway)
CLINICBOT_TRIAGE_MODE=rules
CLINICBOT_LLM_BASE_URL=http://llm-gateway:8080
CLINICBOT_LLM_API_KEY=
CLINICBOT_LLM_MODEL=gpt-4o-mini

# Odoo external API (Settings > Users > API keys). Leave URL empty to queue bookings in the outbox.
CLINICBOT_ODOO_URL=
CLINICBOT_ODOO_DB=
CLINICBOT_ODOO_USER=
CLINICBOT_ODOO_API_KEY=
